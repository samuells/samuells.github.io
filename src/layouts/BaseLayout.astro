---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = '/assets/samuel-speaking.jpg' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <link rel="preload" href="/fonts/SairaSemiCondensed-Black.ttf" as="font" type="font/ttf" crossorigin />
  <link rel="preload" href="/fonts/SairaSemiCondensed-Bold.ttf" as="font" type="font/ttf" crossorigin />
</head>
<body>
  <slot />
</body>
</html>
