---
interface Props {
  email?: string;
}
const { email = 'samuell.snopko@gmail.com' } = Astro.props;

const year = new Date().getFullYear();
---
<footer class="site-footer" role="contentinfo">
  <div class="site-footer-inner">

    <div class="site-footer-top">
      <p class="site-footer-eyebrow eyebrow reveal" style="--d: 0ms">
        Get in Touch
      </p>
      <p class="site-footer-heading reveal" style="--d: 80ms" aria-label="Let's talk">
        Let's Talk.
      </p>
      <p class="site-footer-sub reveal" style="--d: 160ms">
        Open to product leadership roles, advisory work, and interesting collaborations.
      </p>
    </div>

    <nav
      class="site-footer-links reveal"
      style="--d: 240ms"
      aria-label="Contact links"
    >
      <a
        class="footer-link"
        href={`mailto:${email}`}
        aria-label={`Send an email to Samuel Snopko at ${email}`}
      >
        <span class="footer-link-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
          </svg>
        </span>
        <span class="footer-link-label">Email</span>
        <span class="footer-link-value">{email}</span>
        <span class="footer-link-arrow" aria-hidden="true">→</span>
      </a>

      <a
        class="footer-link"
        href="https://linkedin.com/in/samuelsnopko"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Samuel Snopko on LinkedIn (opens in new tab)"
      >
        <span class="footer-link-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 100-4.12 2.06 2.06 0 000 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/>
          </svg>
        </span>
        <span class="footer-link-label">LinkedIn</span>
        <span class="footer-link-value">samuelsnopko</span>
        <span class="footer-link-arrow" aria-hidden="true">↗</span>
      </a>

      <a
        class="footer-link"
        href="https://github.com/samuells"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Samuel Snopko on GitHub (opens in new tab)"
      >
        <span class="footer-link-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
          </svg>
        </span>
        <span class="footer-link-label">GitHub</span>
        <span class="footer-link-value">samuells</span>
        <span class="footer-link-arrow" aria-hidden="true">↗</span>
      </a>
    </nav>

    <div class="site-footer-bottom">
      <p class="site-footer-copy">© {year} Samuel Snopko</p>
    </div>

  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-ink-900);
    color: var(--color-fg-inverse);
    padding-block: var(--spacing-9) var(--spacing-7);
  }

  .site-footer-inner {
    max-width: 1320px;
    margin-inline: auto;
    padding-inline: var(--container-pad);
  }

  /* Top block — headline */
  .site-footer-top {
    padding-bottom: var(--spacing-8);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: var(--spacing-7);
  }

  .site-footer-eyebrow {
    color: var(--color-firebrick-400);
    margin-bottom: var(--spacing-4);
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .site-footer-eyebrow::before {
    content: '';
    width: 28px;
    height: 2px;
    background: currentColor;
    flex-shrink: 0;
  }

  .site-footer-heading {
    font-family: var(--font-display);
    font-weight: var(--weight-black);
    font-size: clamp(52px, 8vw, 104px);
    line-height: 0.95;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    color: var(--color-cream-50);
    margin-bottom: var(--spacing-5);
  }

  .site-footer-sub {
    font-family: var(--font-serif);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-fg-inverse-muted);
    max-width: 48ch;
    letter-spacing: -0.01em;
  }

  /* Contact links */
  .site-footer-links {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--spacing-8);
  }

  .footer-link {
    display: grid;
    grid-template-columns: 44px 90px 1fr 28px;
    align-items: center;
    gap: 20px;
    padding-block: 20px;
    padding-inline: 12px;
    margin-inline: -12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    color: var(--color-fg-inverse);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition:
      background var(--dur-base) var(--ease-out),
      padding-inline-start var(--dur-base) var(--ease-out);
  }

  .footer-link:first-child {
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }

  .footer-link:hover {
    background: rgba(255, 255, 255, 0.05);
    padding-inline-start: 20px;
  }
  .footer-link:hover .footer-link-arrow {
    transform: translate(3px, -3px);
    color: var(--color-cream-50);
  }

  .footer-link:focus-visible {
    outline: 2px solid var(--color-firebrick-400);
    outline-offset: 4px;
  }

  .footer-link-icon {
    width: 44px;
    height: 44px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition:
      background var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }
  .footer-link:hover .footer-link-icon {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
  }
  .footer-link-icon svg { width: 18px; height: 18px; }

  .footer-link-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-fg-inverse-muted);
  }

  .footer-link-value {
    font-family: var(--font-sans);
    font-weight: var(--weight-semibold);
    font-size: var(--text-lg);
    color: var(--color-cream-50);
    letter-spacing: -0.01em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .footer-link-arrow {
    font-size: var(--text-base);
    color: var(--color-fg-subtle);
    justify-self: end;
    transition:
      transform var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }

  /* Bottom bar */
  .site-footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .site-footer-copy {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-fg-subtle);
    opacity: 0.5;
  }

  /* Mobile */
  @media (max-width: 640px) {
    .footer-link {
      grid-template-columns: 40px 1fr 24px;
      grid-template-rows: auto auto;
      gap: 4px 12px;
    }
    .footer-link-icon {
      grid-row: 1 / 3;
      width: 40px;
      height: 40px;
    }
    .footer-link-label {
      grid-column: 2;
      grid-row: 1;
      align-self: end;
    }
    .footer-link-value {
      grid-column: 2;
      grid-row: 2;
      font-size: var(--text-base);
      align-self: start;
    }
    .footer-link-arrow {
      grid-column: 3;
      grid-row: 1 / 3;
      align-self: center;
    }
  }
</style>
