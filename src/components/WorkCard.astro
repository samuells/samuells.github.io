---
export interface Stat {
  value: string;
  label: string;
}

export interface WorkItem {
  title: string;
  description: string;
  href: string;
  tags?: string[];
  year?: string | number;
  role?: string;
  stats?: Stat[];
  isExternal?: boolean;
}

interface Props extends WorkItem {}

const {
  title,
  description,
  href,
  year,
  role,
  stats = [],
  isExternal = false,
} = Astro.props;

const externalProps = isExternal
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---
<article class="work-card">
  <a
    class="work-card-link"
    href={href}
    aria-label={`${title}${role ? ` — ${role}` : ''}`}
    {...externalProps}
  >
    <div class="work-card-meta" aria-hidden="true">
      {year && <span class="work-card-year">{year}</span>}
      {role && <span class="work-card-role">{role}</span>}
    </div>

    <h3 class="work-card-title">{title}</h3>

    <p class="work-card-desc">{description}</p>

    {stats.length > 0 && (
      <ul class="work-card-stats" role="list">
        {stats.map(({ value, label }) => (
          <li class="work-card-stat">
            <strong class="work-card-stat-value">{value}</strong>
            <span class="work-card-stat-label">{label}</span>
          </li>
        ))}
      </ul>
    )}

    <span class="work-card-arrow" aria-hidden="true">
      {isExternal ? '↗' : '→'}
    </span>
  </a>
</article>

<style>
  .work-card {
    border-top: 1px solid var(--color-border);
  }

  .work-card-link {
    display: grid;
    grid-template-columns: 56px 1fr 1fr auto auto;
    gap: clamp(20px, 3.5vw, 48px);
    align-items: center;
    padding-block: 28px;
    padding-inline: 16px;
    margin-inline: -16px;
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-md);
    transition: background var(--dur-base) var(--ease-out);
  }

  .work-card-link:hover {
    background: var(--color-cream-100);
  }
  .work-card-link:hover .work-card-title {
    color: var(--color-firebrick);
  }
  .work-card-link:hover .work-card-arrow {
    transform: translate(3px, -3px);
    color: var(--color-firebrick);
  }

  .work-card-link:focus-visible {
    outline: 2px solid var(--color-firebrick);
    outline-offset: 4px;
  }

  /* Meta: year + role stacked */
  .work-card-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex-shrink: 0;
  }

  .work-card-year {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-firebrick);
    line-height: 1.2;
  }

  .work-card-role {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--color-firebrick);
    line-height: 1.2;
  }

  /* Title */
  .work-card-title {
    font-family: var(--font-sans);
    font-weight: var(--weight-black);
    font-size: clamp(16px, 2vw, 24px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-fg);
    margin: 0;
    transition: color var(--dur-base) var(--ease-out);
  }

  /* Description */
  .work-card-desc {
    font-family: var(--font-serif);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-fg-muted);
    margin: 0;
    letter-spacing: -0.01em;
  }

  /* Stats */
  .work-card-stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .work-card-stat {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .work-card-stat-value {
    font-weight: var(--weight-bold);
    color: var(--color-fg);
  }

  .work-card-stat-label {
    color: var(--color-fg-muted);
  }

  /* Arrow */
  .work-card-arrow {
    font-size: var(--text-lg);
    color: var(--color-fg-subtle);
    line-height: 1;
    flex-shrink: 0;
    transition:
      transform var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }

  /* Mobile */
  @media (max-width: 640px) {
    .work-card-link {
      grid-template-columns: 1fr auto;
      gap: 12px 16px;
    }

    .work-card-meta {
      grid-column: 1;
      flex-direction: row;
      gap: 8px;
    }

    .work-card-title {
      grid-column: 1;
      font-size: clamp(18px, 5vw, 22px);
    }

    .work-card-desc {
      grid-column: 1;
    }

    .work-card-stats {
      grid-column: 1;
    }

    .work-card-arrow {
      grid-column: 2;
      grid-row: 1 / -1;
      align-self: center;
    }
  }
</style>
