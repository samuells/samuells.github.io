---
interface Props {
  eyebrow?: string;
  headline: string;
  subheadline?: string;
}
const { eyebrow, headline, subheadline } = Astro.props;
---
<section class="page-hero" aria-labelledby="page-hero-heading">
  {eyebrow && (
    <p class="page-hero-eyebrow eyebrow reveal" style="--d: 0ms">
      {eyebrow}
    </p>
  )}

  <h1
    id="page-hero-heading"
    class="page-hero-headline reveal"
    style="--d: 80ms"
    set:html={headline}
  />

  {subheadline && (
    <p class="page-hero-sub reveal" style="--d: 180ms">{subheadline}</p>
  )}
</section>

<style>
  .page-hero {
    padding-block: var(--spacing-9) var(--spacing-8);
  }

  /* Eyebrow — mono line + text, same visual language as HeroSection */
  .page-hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: var(--spacing-4);
  }
  .page-hero-eyebrow::before {
    content: '';
    width: 28px;
    height: 2px;
    background: currentColor;
    flex-shrink: 0;
  }

  .page-hero-headline {
    font-family: var(--font-display);
    font-weight: var(--weight-black);
    font-size: clamp(52px, 7vw, 104px);
    line-height: 0.96;
    letter-spacing: -0.025em;
    color: var(--color-ink-900);
    text-transform: uppercase;
    text-wrap: balance;
    margin-bottom: var(--spacing-6);
  }

  .page-hero-sub {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-fg-muted);
    max-width: 58ch;
    letter-spacing: -0.01em;
  }

  @media (max-width: 640px) {
    .page-hero { padding-block: var(--spacing-7) var(--spacing-6); }
    .page-hero-headline { font-size: clamp(40px, 12vw, 60px); }
  }
</style>
